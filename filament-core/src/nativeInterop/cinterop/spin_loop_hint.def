package = dev.karmakrafts.filament.intrinsics
compilerOpts = -Isrc/c/include

---

#include <filament/filament.h>

#if defined(FILAMENT_I386) || defined(FILAMENT_AMD64)
#include <immintrin.h> // For the _mm_pause intrinsic
#endif

FILAMENT_API static inline void filament_spin_loop_hint() {
#if defined(FILAMENT_I386) || defined(FILAMENT_AMD64)
    _mm_pause();
#elif defined(FILAMENT_ARM32) || defined(FILAMENT_ARM64)
    __asm__ volatile("yield" ::: "memory"); // Is the same on ARMv7 and ARMv8
#endif
}